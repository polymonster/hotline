{
    include: [
        "raytracing_example.hlsl"
    ]
    sampler_states: {
        linear_clamp: {
            filter: "Linear",
            address_u: "Clamp",
            address_v: "Clamp",
            address_w: "Clamp",
        }
    }

    pipelines: {
        raytracing: {
            lib: ["raygen_shader", "closest_hit_shader", "miss_shader"]
            hit_groups: [
                {
                    name: "hit_group"
                    closest_hit: "closest_hit_shader"
                    geometry: Triangles
                }
            ]
            push_constants: [
                "raygen_constants"
            ]
            sbt: {
                ray_generation_shader: "raygen_shader",
                miss_shaders: ["miss_shader"],
                hit_groups: ["hit_group"],
            }
        }
        raytracing_inline: {
            cs: cs_raytrace_inline,
            push_constants: [
                "raygen_constants"
            ]
        }
        blit: {
            vs: vs_blit,
            ps: ps_blit,
            push_constants: [
                "blit_constants"
            ]
            static_samplers: {
                blit_sampler: "linear_clamp"
            }
            topology: "TriangleList"
        }
    }
}
